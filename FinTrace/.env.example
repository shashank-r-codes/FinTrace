# =============================================================================
# FinTrace Environment Configuration Template
# Copy to .env and fill in values before running docker-compose or local dev.
# Never commit real secrets to version control.
# =============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=fintrace
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=fintrace_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fintrace:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/fintrace_db

# --- Backend Express API ---
NODE_ENV=development
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
LOG_LEVEL=info

# --- JWT Authentication (generate 64-byte random hex strings) ---
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- ML & Graph Service (Python FastAPI) ---
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000
ML_ARTIFACTS_DIR=/app/artifacts

# --- Google Gemini API (Backend-Only; never expose to frontend) ---
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-4-hydrogen

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_TITLE=FinTrace Command Centre
VITE_SYNTHETIC_BANNER=true
